{
  "name": "ebook-scape",
  "version": "1.0.0",
  "description": "Convert blog posts to PDF or EPUB eBooks",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "bin": {
    "ebook-scape": "./dist/index.js"
  },
  "scripts": {
    "clean:dist": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "clean:pkg": "node -e \"require('fs').rmSync('node_modules/puppeteer/.local-chromium', { recursive: true, force: true }); require('fs').rmSync('node_modules/puppeteer-core/.local-chromium', { recursive: true, force: true })\"",
    "build": "npm run clean:dist && tsc",
    "download:chromium": "node scripts/download-chromium.mjs",
    "build:exe": "npm run build && npm run clean:pkg && npm run download:chromium && pkg package.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts"
  },
  "pkg": {
    "scripts": [
      "dist/index.js",
      "node_modules/puppeteer-extra-plugin-stealth/evasions/*/index.js",
      "node_modules/puppeteer-extra-plugin-stealth/evasions/_utils/index.js",
      "node_modules/puppeteer-extra-plugin-stealth/evasions/_utils/withUtils.js"
    ],
    "targets": [
      "node22-linux-x64",
      "node22-win-x64",
      "node22-macos-x64"
    ],
    "outputPath": "build",
    "assets": [
      "dist/package.json",
      "node_modules/**/*.node"
    ]
  },
  "keywords": [
    "pdf",
    "ebook",
    "epub",
    "blog",
    "scraper",
    "cli"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "chalk": "^4.1.2",
    "chrome-paths": "^1.0.1",
    "commander": "^12.0.0",
    "epub-gen-memory": "^1.1.2",
    "extract-zip": "^2.0.1",
    "jsdom": "^24.0.0",
    "ora": "^5.4.1",
    "p-limit": "^7.3.0",
    "puppeteer-core": "^22.0.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "@puppeteer/browsers": "^2.13.0",
    "@types/jsdom": "^21.1.0",
    "@types/node": "^20.11.0",
    "@types/p-limit": "^2.1.0",
    "@yao-pkg/pkg": "^6.14.1",
    "ts-node": "^10.9.0",
    "typescript": "^5.4.0"
  }
}
